# ============================================================================
# ENVIRONMENT VARIABLES — phimtuoitho
# Copy file này thành ".env" để chạy local (npm run dev / vercel dev),
# và khai báo TỪNG BIẾN này trên Vercel Dashboard:
#   Project → Settings → Environment Variables
# KHÔNG bao giờ commit file ".env" thật lên Git (đã có trong .gitignore).
# ============================================================================


# ─── 1. FIREBASE — client (Vite, cần prefix VITE_ để lộ ra bundle FE) ───────
# Lấy tại: Firebase Console → Project Settings → General → "Your apps" (Web app)
# Đây KHÔNG phải secret bí mật (đây là config public của Firebase Web SDK),
# nhưng nên set riêng cho từng môi trường (dev/staging/production) nếu bạn
# tách nhiều Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── 2. FIREBASE ADMIN — server (dùng trong api/*.js, KHÔNG lộ ra client) ───
# Lấy tại: Firebase Console → Project Settings → Service Accounts
#   → "Generate new private key" → tải file JSON → copy 3 giá trị bên dưới
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Giữ nguyên các ký tự \n trong private key (dán nguyên chuỗi trong file JSON,
# kể cả dấu ngoặc kép và \n) — code sẽ tự convert \n → xuống dòng thật.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── 3. TELEGRAM BOT (thông báo phim mới / tập mới) ─────────────────────────
# Tạo bot qua @BotFather trên Telegram để lấy token, lấy chat_id bằng
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secret dùng để endpoint /api/telegram-notify xác thực request gọi tới
# (đặt một chuỗi ngẫu nhiên dài, KHÔNG dùng lại secret cũ đã bị lộ trong code).
NOTIFY_SECRET=
# Bản sao secret ở phía client để gọi API trên — LƯU Ý: mọi biến VITE_* đều
# nằm public trong bundle JS, nên đây chỉ chặn gọi nhầm/spam vãng lai chứ
# không phải cơ chế bảo mật thực sự.
VITE_NOTIFY_SECRET=

# ─── 4. DISCORD (tuỳ chọn, thông báo phim mới qua Discord) ──────────────────
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ─── 5. UPSTASH REDIS (chống spam thông báo trùng lặp trong check-new-movies) ─
# Tạo free DB tại https://upstash.com → lấy REST URL & REST TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── 6. CRON / SEO ───────────────────────────────────────────────────────────
# Secret để bảo vệ endpoint /api/check-new-movies khỏi bị gọi tuỳ tiện
# (GitHub Actions workflow .github/workflows/check-new-movies.yml gửi header
# x-cron-secret kèm giá trị này).
CRON_SECRET=

# URL domain chính thức của site (dùng để build link tuyệt đối trong thông báo,
# sitemap, RSS...).
SITE_URL=https://phimtuoitho.co

# Key dùng để submit URL mới lên IndexNow (Bing/Yandex). Phải khớp với tên file
# <key>.txt đặt trong thư mục public/ (vd: public/phimtuoitho2026indexnowkey....txt)
INDEXNOW_KEY=

# ─── 7. NẠP THẺ CÀO (GachTheFast) ────────────────────────────────────────────
# Lấy tại mục "Thông tin kết nối" trên dashboard gachthefast.com
GACHTHEFAST_PARTNER_ID=
GACHTHEFAST_PARTNER_KEY=
# Tuỳ chọn — mặc định là gachthefast.com nếu không set
GACHTHEFAST_DOMAIN=gachthefast.com
