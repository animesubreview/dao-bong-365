# ════════════════════════════════════════════════════════════════
#  ĐẢO PHIM — Danh sách biến môi trường
#  • Local: copy file này thành .env.local rồi điền giá trị thật
#  • Vercel: Project → Settings → Environment Variables (thêm từng biến)
#  • KHÔNG commit file .env / .env.local lên GitHub
#  • Sau khi thêm/sửa biến trên Vercel phải Redeploy thì mới có hiệu lực
# ════════════════════════════════════════════════════════════════

# ── PHÍA TRÌNH DUYỆT (bắt buộc có tiền tố VITE_, được nhúng vào bundle → KHÔNG để bí mật thật) ──

# Trùng giá trị với NOTIFY_SECRET bên dưới (xem ghi chú trong README về giới hạn bảo mật)
VITE_NOTIFY_SECRET=

# Firebase Web config — TÙY CHỌN (không đặt thì dùng giá trị mặc định trong src/lib/firebase.ts)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# ── PHÍA SERVER (api/*.js — KHÔNG có VITE_, không bao giờ lộ ra trình duyệt) ──

# Telegram bot (lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chuỗi ngẫu nhiên dài, dùng để xác thực request từ web tới /api/telegram-notify
NOTIFY_SECRET=

# Chống người lạ gọi /api/check-new-movies (GitHub Actions gửi kèm header x-cron-secret)
# Đặt cùng giá trị này vào GitHub → Settings → Secrets → Actions → CRON_SECRET
CRON_SECRET=

# Website
SITE_URL=https://daophim.online
INDEXNOW_KEY=daophim2026indexnowkey9f8a7b6c

# Upstash Redis (lưu danh sách phim đã thông báo, tránh gửi trùng)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Discord (tùy chọn)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Nạp thẻ (GachTheFast)
GACHTHEFAST_PARTNER_ID=
GACHTHEFAST_PARTNER_KEY=
GACHTHEFAST_DOMAIN=gachthefast.com

# Firebase Admin SDK (Firebase Console → Project Settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Giữ nguyên dấu \n trong private key, bọc trong dấu nháy kép
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
