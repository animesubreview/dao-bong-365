# ════════════════════════════════════════════════════════════════
#  ĐẢO PHIM — Danh sách biến môi trường
#  • Local: copy file này thành .env.local rồi điền giá trị thật
#  • Vercel: Project → Settings → Environment Variables (thêm từng biến)
#  • KHÔNG commit file .env / .env.local lên GitHub
#  • Sau khi thêm/sửa biến trên Vercel phải Redeploy thì mới có hiệu lực
# ════════════════════════════════════════════════════════════════

# ── PHÍA TRÌNH DUYỆT (bắt buộc có tiền tố VITE_, được nhúng vào bundle → KHÔNG để bí mật thật) ──

# Trùng giá trị với NOTIFY_SECRET bên dưới (xem ghi chú trong README về giới hạn bảo mật)
VITE_NOTIFY_SECRET=

# Supabase — bắt buộc, lấy ở Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://doogsouthxqbovguakhg.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable__Q4jdqlyBvkVqBoyiW9rOw_hknQu-7Z

# Firebase Web config — KHÔNG DÙNG NỮA (đã chuyển sang Supabase), giữ lại phòng khi cần rollback
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# ── PHÍA SERVER (api/*.js — KHÔNG có VITE_, không bao giờ lộ ra trình duyệt) ──

# Telegram bot (lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chuỗi ngẫu nhiên dài, dùng để xác thực request từ web tới /api/telegram-notify
NOTIFY_SECRET=

# Chống người lạ gọi /api/check-new-movies (GitHub Actions gửi kèm header x-cron-secret)
# Đặt cùng giá trị này vào GitHub → Settings → Secrets → Actions → CRON_SECRET
CRON_SECRET=

# Website
SITE_URL=https://daophim.online
INDEXNOW_KEY=daophim2026indexnowkey9f8a7b6c

# Upstash Redis (lưu danh sách phim đã thông báo, tránh gửi trùng)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Discord (tùy chọn)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Nạp thẻ (GachTheFast)
GACHTHEFAST_PARTNER_ID=
GACHTHEFAST_PARTNER_KEY=
GACHTHEFAST_DOMAIN=gachthefast.com

# Supabase Admin (dùng cho api/card-callback.js, api/charge-card.js) — service_role key,
# lấy cùng trang Project Settings → API (mục "service_role", KHÔNG phải anon key)
SUPABASE_URL=https://doogsouthxqbovguakhg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Admin SDK — KHÔNG DÙNG NỮA (đã chuyển sang Supabase ở trên), giữ lại phòng khi cần rollback
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Giữ nguyên dấu \n trong private key, bọc trong dấu nháy kép
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Chỉ cần khi web chạy trên HOSTING TĨNH (khác domain với Vercel) ──
# Trỏ các chức năng cần server (nạp thẻ, proxy phát phim, telegram) về domain Vercel. Không có dấu / ở cuối.
# VITE_API_BASE=https://ten-du-an.vercel.app

# Auraflix API (đặt trên Vercel, không để trong code)
# AURAFLIX_API_KEY=mh_live_xxx
# AURAFLIX_API_BASE=https://auraflixcms.pages.dev/api/v1

# Lưu ảnh tải lên trên hosting (xem hosting-upload/HUONG_DAN.md). Bỏ trống = dùng Supabase Storage
# VITE_UPLOAD_URL=https://cdn.daophim.online
