{
  // Web tĩnh (dist) + Worker nhỏ chỉ xử lý SEO / sitemap / chuyển hướng.
  "name": "dao-bong-365",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Chỉ các đường dẫn này mới chạy Worker (tiết kiệm quota 100k request/ngày)
    "run_worker_first": [
      "/phim/*", "/watch/*", "/watch-manual/*", "/manual/*", "/type/*", "/movie/*",
      "/sitemap-movies.xml", "/sitemap-categories.xml", "/sitemap-images.xml", "/rss.xml"
    ]
  },
  "vars": { "API_BASE": "https://api.daophim.online" }
}
