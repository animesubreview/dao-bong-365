# ── Hosting tĩnh (Apache / LiteSpeed / cPanel / DirectAdmin) ─────────────────
# File này tự được chép vào thư mục dist khi chạy `npm run build`.
# Nhiệm vụ: cho mọi đường dẫn (/phim/abc, /watch/..., /chat ...) trả về index.html
# để React Router xử lý — nếu thiếu, bấm F5 ở trang con sẽ báo 404.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ép về HTTPS (bỏ 3 dòng này nếu hosting đã tự ép HTTPS)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Đường dẫn cũ /movie/xxx -> /phim/xxx
  RewriteRule ^movie/(.*)$ /phim/$1 [R=301,L]

  # File trong /assets/ không tồn tại (vd. chunk cũ sau khi deploy) → trả 404 thật.
  # KHÔNG trả index.html, nếu không trình duyệt nhận HTML thay vì JS và báo
  # "Failed to fetch dynamically imported module".
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/ - [R=404,L]

  # File/thư mục có thật thì phục vụ bình thường, còn lại trả index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# Cache: file trong /assets có mã băm trong tên -> cache 1 năm; index.html luôn kiểm tra lại
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
